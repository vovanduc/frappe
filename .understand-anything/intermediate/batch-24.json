      "complexity": 8
    },
    {
      "id": "class:Report",
      "type": "class",
      "name": "Report",
      "filePath": "frappe/core/doctype/report/report.py",
      "lineRange": [20, 417],
      "summary": "Document controller for Report DocType. Supports four report types (Report Builder, Query Report, Script Report, Custom Report). Implements validation with role-based access control, query execution with SQL safety checks, script execution via safe_exec sandbox, standard report building with group-by/aggregate support, prepared report auto-enablement, and export to files for standard reports.",
      "tags": ["document", "report", "query-execution", "rbac", "safe-exec"],
      "complexity": 8
    },
